{
  "manifest_version": 3,
  "name": "Water Reminder",
  "version": "1.0.0",
  "description": "Remind yourself to drink water at a custom interval, with a custom message and sound.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Water Reminder",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
